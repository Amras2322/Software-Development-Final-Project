<%- include('../partials/head', { title: title }) %>

<h2>Tickets</h2>

<p><a href="/tickets/new" class="button">Add ticket</a></p>

<% if (tickets.length === 0) { %>
  <p>No tickets yet.</p>
<% } else { %>
  <table>
    <thead>
      <tr><th>Title</th><th>Priority</th><th>Status</th><th>Asset</th><th></th></tr>
    </thead>
    <tbody>
      <% tickets.forEach(function (ticket) { %>
        <tr>
          <td><a href="/tickets/<%= ticket.id %>"><%= ticket.title %></a></td>
          <td><%= ticket.priority %></td>
          <td><%= ticket.status %></td>
          <td><%= ticket.Asset ? ticket.Asset.name : "-" %></td>
          <td>
            <a href="/tickets/<%= ticket.id %>/edit">Edit</a>
            <form method="post" action="/tickets/<%= ticket.id %>/delete" class="inline">
              <button type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
