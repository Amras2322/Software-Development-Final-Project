<%- include('../partials/head', { title: title }) %>

<h2><%= asset && asset.id ? "Edit asset" : "New asset" %></h2>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<form method="post" action="<%= asset && asset.id ? '/assets/' + asset.id : '/assets' %>">
  <label>Name
    <input type="text" name="name" value="<%= asset ? asset.name : '' %>" required>
  </label>
  <label>Type
    <input type="text" name="type" value="<%= asset ? asset.type : '' %>" placeholder="laptop, switch, server..." required>
  </label>
  <label>Serial number
    <input type="text" name="serialNumber" value="<%= asset && asset.serialNumber ? asset.serialNumber : '' %>">
  </label>
  <button type="submit">Save</button>
</form>

<p><a href="/assets">Back to assets</a></p>

<%- include('../partials/footer') %>
